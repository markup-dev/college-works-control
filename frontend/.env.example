# Базовый URL backend API. Используется в src/services/api.js.
# По умолчанию при сборке без переменной используется http://localhost:8000/api.
REACT_APP_API_URL=http://localhost:8000/api

# Публичный URL фронтенда для sitemap.xml и robots.txt (абсолютные ссылки для поисковиков).
# Пример продакшена:
# REACT_APP_SITE_URL=https://portal.example.edu
#
# По умолчанию при сборке без переменной используется http://localhost:3000 — для деплоя задайте свой домен.
REACT_APP_SITE_URL=
